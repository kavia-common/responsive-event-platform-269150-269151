# FastAPI configuration
APP_TITLE=Events Backend API
APP_VERSION=0.1.0
APP_ENV=development
LOG_LEVEL=INFO

# CORS (comma-separated). Include your frontend dev/prod URLs.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# MongoDB (events_database). Provide one of:
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=events

# Public URL hints (optional; used in docs/links)
FRONTEND_URL=http://localhost:5173

# WebSocket path (frontend defaults to ws://localhost:3001/ws)
WS_PATH=/ws
